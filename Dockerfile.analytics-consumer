FROM public.ecr.aws/docker/library/golang:1.27.2-alpine AS builder

RUN apk add --no-cache ca-certificates

WORKDIR /src

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux \
    go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/shortscale-analytics-consumer \
    ./cmd/analytics-consumer

FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/shortscale-analytics-consumer /shortscale-analytics-consumer

USER 65532:65532

EXPOSE 9091

ENTRYPOINT ["/shortscale-analytics-consumer"]
